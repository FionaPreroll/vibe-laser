{
  "name": "vibe-laser",
  "version": "0.0.0",
  "private": true,
  "description": "A laser logic puzzle for the browser.",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "schemas": "vitest run src/content/schema.test.ts --update",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "@preact/signals-core": "^1.14.4",
    "idb-keyval": "^6.3.0",
    "pixi.js": "^8.22.0",
    "preact": "^11.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
